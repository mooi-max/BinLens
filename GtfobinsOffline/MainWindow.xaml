<Window x:Class="GtfobinsOffline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BinLens · GTFOBins Offline" Height="760" Width="1240" MinHeight="620" MinWidth="1020" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" Background="{DynamicResource Accent}" CornerRadius="13" Margin="0,0,13,0">
                    <TextBlock Text="&gt;_" Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock x:Name="AppTitle" Text="BinLens" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppSubtitle" Text="GTFOBins 离线速查 · 本地数据 · 不执行命令" Foreground="{DynamicResource SecondaryForeground}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LanguageButton" Content="English" Click="LanguageButton_Click" Margin="0,0,8,0" />
                <Button x:Name="ThemeButton" Content="深色" Click="ThemeButton_Click" Margin="0,0,8,0" />
                <Button x:Name="AboutButton" Content="关于" Click="AboutButton_Click" Margin="0,0,8,0" />
                <Button x:Name="UpdateButton" Content="检查更新" Padding="9,7" Click="UpdateButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="SearchView" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Height="46" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource TertiaryForeground}" Margin="13,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Height="44" FontSize="16" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Ctrl+F" BorderThickness="0" Background="Transparent" Padding="40,0,12,0" />
                        <TextBlock x:Name="SearchHint" Text="搜索命令、别名或功能，例如 find、python、Sudo" IsHitTestVisible="False" Foreground="{DynamicResource TertiaryForeground}" Margin="42,0,12,0" VerticalAlignment="Center" Visibility="Visible" />
                    </Grid>
                </Border>
                <Button x:Name="BatchButton" Grid.Column="2" Content="批量分析" Style="{StaticResource AccentButton}" MinWidth="94" Click="BatchButton_Click" />
            </Grid>
            <WrapPanel Grid.Row="2">
                <Button x:Name="FilterAllButton" Tag="" Content="全部" Click="FilterButton_Click" Margin="0,0,8,0" />
                <Button x:Name="FilterSudoButton" Tag="sudo" Content="Sudo" Click="FilterButton_Click" Margin="0,0,8,0" />
                <Button x:Name="FilterSuidButton" Tag="suid" Content="SUID" Click="FilterButton_Click" Margin="0,0,8,0" />
                <Button x:Name="FilterCapabilitiesButton" Tag="capabilities" Content="Capabilities" Click="FilterButton_Click" Margin="0,0,8,0" />
                <Button x:Name="FilterUserButton" Tag="unprivileged" Content="普通用户" Click="FilterButton_Click" />
            </WrapPanel>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="10">
                    <DockPanel>
                        <TextBlock x:Name="ResultCountText" DockPanel.Dock="Top" Margin="8,5,8,8" Foreground="{DynamicResource SecondaryForeground}" />
                        <ListBox x:Name="ResultList" SelectionChanged="ResultList_SelectionChanged" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel">
                            <TextBlock x:Name="EmptyDetailTitle" FontSize="22" FontWeight="SemiBold" Margin="0,45,0,8" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDetailText" Foreground="{DynamicResource SecondaryForeground}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="BatchView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="190" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="← 返回检索" Click="BackButton_Click" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock x:Name="BatchTitle" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="BatchDescription" Foreground="{DynamicResource SecondaryForeground}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2">
                <TextBox x:Name="BatchInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="12" />
                <Button x:Name="AnalyzeButton" Content="分析 sudo -l 输出" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Click="AnalyzeButton_Click" />
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <DockPanel>
                        <TextBlock x:Name="BatchResultTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="6,4,6,8" />
                        <ListBox x:Name="BatchResultList" SelectionChanged="BatchResultList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="BatchDetailPanel" /></ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="4,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryForeground}" FontSize="12" />
        </Border>
    </Grid>
</Window>
